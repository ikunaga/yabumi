# Supabase（ローカルでは `supabase status` で確認できる）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# サーバー専用。RLS を通らないので画面側（NEXT_PUBLIC_）には出さない。ローカルは `supabase status` の Secret key
SUPABASE_SECRET_KEY=

# 新規登録を許すメールアドレス（カンマ区切り）。未設定なら誰でも登録できる（ローカルの開発）。
# 本番では空（ALLOWED_SIGNUP_EMAILS=）にして登録を閉じ、オーナーのアカウントは Supabase の画面で作る（docs/deploy.md）
# ALLOWED_SIGNUP_EMAILS=

# ロボットの確認（Cloudflare Turnstile）の Site Key。空なら出さない（ローカル）。本番で登録の受付を開く前に入れる（docs/deploy.md の 5-8）
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# 招待の申し込み（docs/architecture.md の 4.29）を、サーバーでも Turnstile で確かめるときの Secret Key（Supabase に入れたものと同じ値）。なければ確かめない
# TURNSTILE_SECRET_KEY=

# アプリの URL。SNS のコールバック URL の元になる（Threads は https 必須）。ローカルは pnpm dev（https）で開く URL
APP_URL=https://localhost:3100
# 短縮リンクの土台（docs/architecture.md の 4.22）。空なら <APP_URL>/go。本番は go.yabumi.app の DNS ができたら https://go.yabumi.app
SHORT_LINK_BASE_URL=
# 短縮リンクを利用者のドメインで作る（docs/architecture.md の 4.22、D28。docs/deploy.md の 17）。空なら画面は「準備中」。ローカルでは入れない（本物の Vercel のプロジェクトにドメインが足される）
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# 利用者のドメインの、矢書全体の上限（既定 40。Vercel Hobby は 1 プロジェクト 50 まで）
LINK_DOMAIN_LIMIT=
# ストアと課金の鍵（App Store Connect・RevenueCat）を暗号化する鍵（docs/architecture.md の 4.22）。TOKEN_ENCRYPTION_KEY とは別の値（openssl rand -base64 32）
CREDENTIAL_ENCRYPTION_KEY=
# 鍵を入れ替えるときだけ: 古い鍵をカンマ区切りで（docs/deploy.md の 13）
CREDENTIAL_ENCRYPTION_KEYS_OLD=
# 数字を読む権限を求める SNS（Meta のアプリで先に権限を足してから。例 threads,instagram,facebook,x。x は権限の追加は要らないが、読むたびに費用がかかる。docs/deploy.md の 14）
SNS_INSIGHTS=
# X の数字の、利用者 1 人の月の上限（米ドル。既定 1。docs/architecture.md の 4.22）
X_METRICS_USER_MONTHLY_USD=
# Google Play の取り込み: オーナーの Google Cloud の管理用サービスアカウントの JSON の鍵（1 行。docs/deploy.md の 15）
GOOGLE_PLAY_MANAGER_KEY=
# 運営者へのメールの知らせ（docs/deploy.md の 15-11、決定 D22）。どちらかがないと送らず、サーバーのログに残すだけ
RESEND_API_KEY=
OPERATOR_EMAIL=
# 招待の申し込みの一覧（/admin/waitlist）を開ける運営者の、ログインに使うメールアドレス（カンマ区切り。docs/deploy.md の 19）。なければだれも開けない
OPERATOR_ADMIN_EMAILS=
# 送信元（既定 矢書 <noreply@yabumi.app>）
OPERATOR_EMAIL_FROM=
# 伴走のお知らせのメール（利用者あて。docs/architecture.md の 4.27）の送信元。なければ OPERATOR_EMAIL_FROM。RESEND_API_KEY がなければ送らない
NOTIFY_EMAIL_FROM=
# Google Play のつなぎの作成数（直近 30 日、全員）がこの数に達したら運営者に知らせる（カンマ区切り。既定 60,80）
PLAY_CAPACITY_NOTIFY_AT=

# スマホの通知（Web Push。docs/architecture.md の 4.28、docs/deploy.md の 18）。`npx web-push generate-vapid-keys` で作る。
# 3 つそろわないと「準備中」。鍵を作り直すと、登録済みの端末に届かなくなる（利用者が登録し直す）
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# 運営者の連絡先（push サービスが問題のあるときに連絡する先）。mailto: か https:// で始める
VAPID_SUBJECT=

# SNS のアクセストークンを DB に入れる前に暗号化する鍵。`openssl rand -base64 32` で作る。
# 変えると保存済みのトークンが読めなくなる（docs/architecture.md の 4.6）
TOKEN_ENCRYPTION_KEY=

# 定期実行のジョブ（/api/jobs/*）の合言葉。32 文字以上。`openssl rand -hex 32` で作り、Supabase の Vault の cron_secret と同じ値にする
CRON_SECRET=

# Threads 用の Meta アプリ（Instagram・Facebook とは別のアプリ）
THREADS_APP_ID=
THREADS_APP_SECRET=

# X（docs/architecture.md の 4.13）。Developer Console の OAuth 2.0 の Client ID と Client Secret。空なら X は「準備中」
X_CLIENT_ID=
X_CLIENT_SECRET=
# X の Developer Console が localhost の Callback URI を受け付けないときだけ、ローカルで 127.0.0.1 にする（README の「X」）
# X_REDIRECT_ORIGIN=https://127.0.0.1:3100
# X に払う月の上限（米ドル、矢書全体）。空なら 3（決定 D16）。80% に達すると運営者にメールで知らせる
# X_MONTHLY_BUDGET_USD=3
# X の投稿まわり（投稿・確認の読み取り）の、利用者 1 人の月の上限（米ドル）。空なら 1（docs/architecture.md の 4.13）
# X_POST_USER_MONTHLY_USD=1

# Claude API（AI と考えるアカウント設計など）。空なら AI の機能は「準備中」になり、手での入力だけが使える
ANTHROPIC_API_KEY=
# AI の費用の上限（米ドル / 月、回数 / 日）。docs/architecture.md の 4.9。空なら既定値（3 / 10 / 60）。全体の上限の 80% で運営者に知らせる
# AI_USER_MONTHLY_BUDGET_USD=3
# AI_GLOBAL_MONTHLY_BUDGET_USD=10
# AI_USER_DAILY_TURNS=60

# GitHub App（リポジトリを読んでアプリの説明を下書きする。docs/architecture.md の 4.10）。どれかが空なら「準備中」
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# 秘密鍵（.pem の中身）。改行は \n と書いて 1 行にする
GITHUB_APP_PRIVATE_KEY=

# Instagram・Facebook 用の Meta アプリ（Threads とは別。docs/architecture.md の 4.21、docs/deploy.md の 12）。どれかが空なら「準備中」
# App settings → Basic の App ID と App secret（Facebook ページに使う）
META_APP_ID=
META_APP_SECRET=
# Facebook Login for Business の設定（Configuration）の ID
FACEBOOK_LOGIN_CONFIG_ID=
# Instagram のユースケースの画面にある「Instagram app ID / secret」（Meta の App ID とは別の値）
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
